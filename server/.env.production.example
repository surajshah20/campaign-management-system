# ==============================================================================
# AGENCY OS — PRODUCTION BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# Production Database (PostgreSQL recommended e.g. Supabase, Neon, AWS RDS)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?schema=public"

# Cryptographic Session & JWT Secret (Generate with: openssl rand -base64 48)
# MUST be minimum 32 characters, unique, and kept secret.
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_characters!
JWT_EXPIRES_IN=7d

# Allowed Production Frontend Origin (No trailing slash)
CORS_ORIGIN=https://app.youragency.com

# Default Currency Baseline (NPR, USD, EUR, GBP, INR)
DEFAULT_CURRENCY=NPR

# Rate Limiting Window Override (Optional, defaults to 15m)
RATE_LIMIT_WINDOW_MS=900000
