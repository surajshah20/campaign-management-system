datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  firstName      String
  lastName       String
  avatarUrl      String?
  isSuperAdmin   Boolean        @default(false)
  emailVerified  Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  memberships    AgencyMember[]
  clientAccess   ClientMember[]
  assignedTasks  Task[]
  authoredPosts  ContentPost[]
  versionsCreated ContentVersion[]
  taskComments   TaskComment[]
  approvalComments ApprovalComment[]
  activityLogs   ActivityLog[]
  notifications  Notification[]
  uploadedFiles  StorageFile[]

  @@map("users")
}

model Agency {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  logoUrl        String?
  currency       String         @default("NPR")
  timezone       String         @default("Asia/Kathmandu")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  members        AgencyMember[]
  invitations    Invitation[]
  clients        Client[]
  campaigns      Campaign[]
  tasks          Task[]
  contentPosts   ContentPost[]
  adAccounts     AdAccount[]
  adCampaigns    AdCampaign[]
  budgets        Budget[]
  reports        Report[]
  activityLogs   ActivityLog[]
  notifications  Notification[]
  integrations   Integration[]
  storageFiles   StorageFile[]
  subscription   Subscription?
  invoices       BillingInvoice[]

  @@map("agencies")
}

model AgencyMember {
  id        String   @id @default(uuid())
  agencyId  String
  userId    String
  role      String   @default("CAMPAIGN_MANAGER") // AGENCY_OWNER, AGENCY_ADMIN, CAMPAIGN_MANAGER, DESIGNER, CONTENT_WRITER, MARKETING_EXECUTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@index([agencyId])
  @@index([userId])
  @@map("agency_members")
}

model Invitation {
  id        String    @id @default(uuid())
  agencyId  String
  email     String
  role      String    @default("CAMPAIGN_MANAGER")
  tokenHash String    @unique
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime  @default(now())

  agency    Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@map("invitations")
}

model Client {
  id                 String       @id @default(uuid())
  agencyId           String
  name               String
  logoUrl            String?
  industry           String?
  contactPerson      String?
  email              String?
  phone              String?
  website            String?
  assignedManagerId  String?
  status             String       @default("ONBOARDING") // ONBOARDING, ACTIVE, PAUSED, INACTIVE
  internalNotes      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  agency             Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  members            ClientMember[]
  campaigns          Campaign[]
  tasks              Task[]
  contentPosts       ContentPost[]
  reports            Report[]

  @@index([agencyId])
  @@map("clients")
}

model ClientMember {
  id        String   @id @default(uuid())
  clientId  String
  userId    String
  canApprove Boolean @default(true)
  createdAt DateTime @default(now())

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([clientId])
  @@index([userId])
  @@map("client_members")
}

model Campaign {
  id              String         @id @default(uuid())
  agencyId        String
  clientId        String
  name            String
  description     String?
  objective       String?
  campaignType    String         @default("SOCIAL_MEDIA_MARKETING")
  status          String         @default("PLANNING") // DRAFT, PLANNING, ACTIVE, PAUSED, COMPLETED, ARCHIVED
  allocatedBudget Float          @default(0.0)
  targetAudience  String?
  platformsJson   String?        // JSON string e.g. ["FACEBOOK", "INSTAGRAM"]
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  agency          Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks           Task[]
  contentPosts    ContentPost[]
  adCampaigns     AdCampaign[]
  budgets         Budget[]
  reports         Report[]

  @@index([agencyId])
  @@index([clientId])
  @@map("campaigns")
}

model Task {
  id          String      @id @default(uuid())
  agencyId    String
  clientId    String?
  campaignId  String?
  assigneeId  String?
  title       String
  description String?
  priority    String      @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String      @default("TODO")   // TODO, IN_PROGRESS, IN_REVIEW, COMPLETED, BLOCKED
  dueDate     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  agency      Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaign    Campaign?   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assignee    User?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TaskComment[]

  @@index([agencyId])
  @@index([campaignId])
  @@index([assigneeId])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

model ContentPost {
  id            String         @id @default(uuid())
  agencyId      String
  clientId      String
  campaignId    String?
  creatorId     String?
  title         String
  caption       String?
  platform      String         @default("INSTAGRAM") // FACEBOOK, INSTAGRAM, TIKTOK, YOUTUBE, LINKEDIN
  status        String         @default("IDEA")      // IDEA, DRAFT, INTERNAL_REVIEW, CLIENT_APPROVAL, APPROVED, SCHEDULED, PUBLISHED
  scheduledDate DateTime?
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  agency        Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  creator       User?          @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  versions      ContentVersion[]

  @@index([agencyId])
  @@index([clientId])
  @@index([campaignId])
  @@map("content_posts")
}

model ContentVersion {
  id             String        @id @default(uuid())
  contentPostId  String
  versionNumber  Int           @default(1)
  mediaUrl       String?
  mediaType      String?       // "image", "video", "carousel", "pdf"
  captionCopy    String?
  createdById    String?
  createdAt      DateTime      @default(now())

  contentPost    ContentPost   @relation(fields: [contentPostId], references: [id], onDelete: Cascade)
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  approvals      Approval[]

  @@index([contentPostId])
  @@map("content_versions")
}

model Approval {
  id           String         @id @default(uuid())
  versionId    String
  clientId     String
  status       String         @default("PENDING") // PENDING, APPROVED, CHANGES_REQUESTED, REJECTED
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime       @default(now())

  version      ContentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  comments     ApprovalComment[]

  @@index([versionId])
  @@map("approvals")
}

model ApprovalComment {
  id         String   @id @default(uuid())
  approvalId String
  userId     String
  message    String
  createdAt  DateTime @default(now())

  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approvalId])
  @@map("approval_comments")
}

model AdAccount {
  id          String         @id @default(uuid())
  agencyId    String
  platform    String         // META_ADS, GOOGLE_ADS, TIKTOK_ADS, LINKEDIN_ADS
  accountName String
  externalId  String?
  currency    String         @default("NPR")
  createdAt   DateTime       @default(now())

  agency      Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  campaigns   AdCampaign[]

  @@index([agencyId])
  @@map("ad_accounts")
}

model AdCampaign {
  id           String        @id @default(uuid())
  agencyId     String        @default("")
  campaignId   String
  adAccountId  String?
  name         String
  platform     String
  externalId   String?
  status       String        @default("ACTIVE")
  budgetAmount Float         @default(0.0)
  spendAmount  Float         @default(0.0)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  agency       Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adAccount    AdAccount?    @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  metrics      AdMetric[]

  @@index([agencyId])
  @@index([campaignId])
  @@map("ad_campaigns")
}

model AdMetric {
  id           String     @id @default(uuid())
  adCampaignId String
  date         DateTime
  impressions  Int        @default(0)
  reach        Int        @default(0)
  clicks       Int        @default(0)
  spend        Float      @default(0.0)
  conversions  Int        @default(0)
  leads        Int        @default(0)
  revenue      Float      @default(0.0)
  roas         Float      @default(0.0)
  createdAt    DateTime   @default(now())

  adCampaign   AdCampaign @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)

  @@index([adCampaignId, date])
  @@map("ad_metrics")
}

model Budget {
  id              String    @id @default(uuid())
  agencyId        String
  campaignId      String
  allocatedAmount Float     @default(0.0)
  advertisingSpend Float    @default(0.0)
  productionCost  Float     @default(0.0)
  otherExpenses   Float     @default(0.0)
  currency        String    @default("NPR")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agency          Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  expenses        Expense[]

  @@index([agencyId])
  @@index([campaignId])
  @@map("budgets")
}

model Expense {
  id          String   @id @default(uuid())
  budgetId    String
  category    String   // ADVERTISING, PRODUCTION, TALENT, SOFTWARE, OTHER
  amount      Float
  currency    String   @default("NPR")
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@map("expenses")
}

model Report {
  id               String   @id @default(uuid())
  agencyId         String
  clientId         String
  campaignId       String?
  title            String
  shareToken       String   @unique @default(uuid())
  isPubliclyShared Boolean  @default(false)
  summaryJson      String?  // JSON string containing metrics snapshot
  observations     String?
  recommendations  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agency           Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign         Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([clientId])
  @@map("reports")
}

model ActivityLog {
  id         String   @id @default(uuid())
  agencyId   String
  userId     String?
  action     String   // e.g. "CAMPAIGN_CREATED", "TASK_COMPLETED", "CONTENT_APPROVED"
  entityType String   // e.g. "CAMPAIGN", "TASK", "CONTENT", "CLIENT"
  entityId   String?
  metadata   String?  // JSON context
  createdAt  DateTime @default(now())

  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Notification {
  id         String   @id @default(uuid())
  agencyId   String
  userId     String
  type       String   // TASK_ASSIGNMENT, TASK_DEADLINE, CONTENT_APPROVAL_REQUEST, etc.
  title      String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Integration {
  id              String    @id @default(uuid())
  agencyId        String
  provider        String    // META_ADS, GOOGLE_ADS, TIKTOK_ADS, LINKEDIN_ADS, STORAGE_S3, STORAGE_CLOUDINARY
  name            String
  status          String    @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ERROR, SYNCING
  configJson      String?   // Encrypted/masked API credentials, account IDs, webhook secrets
  lastSyncAt      DateTime?
  syncStatus      String?   // SUCCESS, FAILED, PARTIAL
  syncError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agency          Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  syncLogs        SyncLog[]

  @@unique([agencyId, provider])
  @@index([agencyId])
  @@map("integrations")
}

model SyncLog {
  id              String      @id @default(uuid())
  integrationId   String
  agencyId        String
  status          String      // SUCCESS, FAILED, PARTIAL
  recordsProcessed Int        @default(0)
  errorMessage    String?
  startedAt       DateTime    @default(now())
  completedAt     DateTime?

  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([agencyId])
  @@map("sync_logs")
}

model StorageFile {
  id              String    @id @default(uuid())
  agencyId        String
  uploadedById    String?
  fileName        String
  fileSize        Int       @default(0)
  mimeType        String
  storageProvider String    @default("LOCAL") // LOCAL, S3, CLOUDINARY
  publicUrl       String
  metadataJson    String?
  createdAt       DateTime  @default(now())

  agency          Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  uploadedBy      User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@map("storage_files")
}

model Subscription {
  id                   String           @id @default(uuid())
  agencyId             String           @unique
  plan                 String           @default("GROWTH") // STARTER, GROWTH, ENTERPRISE
  billingCycle         String           @default("MONTHLY") // MONTHLY, ANNUAL
  status               String           @default("ACTIVE") // TRIALING, ACTIVE, PAST_DUE, CANCELED
  currentPeriodStart   DateTime         @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean          @default(false)
  trialEndsAt          DateTime?
  paymentMethodBrand   String?          @default("Visa")
  paymentMethodLast4   String?          @default("4242")
  paymentMethodExp     String?          @default("12/28")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  agency               Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  invoices             BillingInvoice[]

  @@map("subscriptions")
}

model BillingInvoice {
  id             String        @id @default(uuid())
  agencyId       String
  subscriptionId String?
  invoiceNumber  String        @unique
  amount         Float
  currency       String        @default("NPR")
  status         String        @default("PAID") // PAID, PENDING, FAILED
  billingReason  String?       // SUBSCRIPTION_CYCLE, PLAN_UPGRADE, ADDON
  invoicePdfUrl  String?
  paidAt         DateTime?     @default(now())
  createdAt      DateTime      @default(now())

  agency         Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([subscriptionId])
  @@map("billing_invoices")
}
